# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Secret for Session Authentication
JWT_SECRET="flux_hosting_jwt_secret_key_2026_super_secure"

# Optional SMTP Settings (can also be configured directly within the panel UI)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@example.com"
SMTP_PASS="secret_password"
SMTP_FROM="Flux Hosting <noreply@example.com>"
SMTP_SECURE="false"

# Optional CAPTCHA Keys (reCAPTCHA / hCaptcha)
RECAPTCHA_SECRET_KEY=""
HCAPTCHA_SECRET_KEY=""

# Pterodactyl Panel API Integration
PTERODACTYL_PANEL_URL="https://panel.fluxhost.com.tr"
PTERODACTYL_API_KEY="ptla_your_application_api_key_here"
PTERODACTYL_CLIENT_API_KEY="ptlc_your_client_api_key_here"
PTERODACTYL_NODE_ID=1
PTERODACTYL_NEST_ID=1
PTERODACTYL_EGG_ID=1
PTERODACTYL_LOCATION_ID=1

